#!/usr/bin/env bash
# SessionStart hook for agent-harness plugin

set -euo pipefail

# Determine plugin root directory
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PLUGIN_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"

# --- Read SessionStart payload (stdin JSON) ---
# Claude Code 2.1.159+ sends a JSON payload on stdin with a `source` field
# (startup | resume | precompact | clear). Older versions send nothing.
# We read it once and keep the parsed fields around (issue #66).
SESSION_SOURCE="startup"
SESSION_ID=""
STDIN_PAYLOAD=""
if [ ! -t 0 ]; then
    STDIN_PAYLOAD=$(cat 2>/dev/null || true)
    if [ -n "$STDIN_PAYLOAD" ] && command -v jq >/dev/null 2>&1; then
        SESSION_SOURCE=$(printf '%s' "$STDIN_PAYLOAD" | jq -r '.source // "startup"' 2>/dev/null || echo "startup")
        SESSION_ID=$(printf '%s' "$STDIN_PAYLOAD" | jq -r '.session_id // empty' 2>/dev/null || true)
    fi
fi
# Default empty payload or older harness → treat as startup.
case "$SESSION_SOURCE" in
    startup|resume|precompact|clear) ;;  # keep value
    *) SESSION_SOURCE="startup" ;;
esac

# --- Subagent detection (issue #67) ---
# Claude Code dispatches subagents with `isSidechain: true` in the payload,
# and subagent transcripts live under `*/subagents/agent-*.jsonl`. Either
# signal is sufficient. We do NOT inject agent-harness context into subagents —
# they should focus on their task brief, not the skill registry.
IS_SUBAGENT="false"
if [ -n "$STDIN_PAYLOAD" ] && command -v jq >/dev/null 2>&1; then
    if [ "$(printf '%s' "$STDIN_PAYLOAD" | jq -r '.isSidechain // false' 2>/dev/null || echo false)" = "true" ]; then
        IS_SUBAGENT="true"
    fi
fi
# Belt-and-suspenders: env var set by some harness versions.
if [ "${CLAUDE_SUBAGENT:-0}" = "1" ]; then
    IS_SUBAGENT="true"
fi

# Subagent injection: minimal, single-line focus reminder. Done — exit early.
if [ "$IS_SUBAGENT" = "true" ]; then
    subagent_context="You are a subagent dispatched for a specific task. Focus on your task brief. Do not invoke other skills unless explicitly required by your task."
    subagent_escaped="${subagent_context//\\/\\\\}"
    subagent_escaped="${subagent_escaped//\"/\\\"}"
    if [ -n "${CURSOR_PLUGIN_ROOT:-}" ]; then
        printf '{\n  "additional_context": "%s"\n}\n' "$subagent_escaped" | cat
    elif [ -n "${CLAUDE_PLUGIN_ROOT:-}" ] && [ -z "${COPILOT_CLI:-}" ]; then
        printf '{\n  "hookSpecificOutput": {\n    "hookEventName": "SessionStart",\n    "additionalContext": "%s"\n  }\n}\n' "$subagent_escaped" | cat
    else
        printf '{\n  "additionalContext": "%s"\n}\n' "$subagent_escaped" | cat
    fi
    exit 0
fi

# Check if legacy skills directory exists and build warning
warning_message=""
legacy_skills_dir="${HOME}/.config/agent-harness/skills"
if [ -d "$legacy_skills_dir" ]; then
    warning_message="\n\n<important-reminder>IN YOUR FIRST REPLY AFTER SEEING THIS MESSAGE YOU MUST TELL THE USER:⚠️ **WARNING:** Agent Harness now uses Claude Code's skills system. Custom skills in ~/.config/agent-harness/skills will not be read. Move custom skills to ~/.claude/skills instead. To make this message go away, remove ~/.config/agent-harness/skills</important-reminder>"
fi

# --- Source-aware injection (issue #66) ---
# - startup / clear → full injection (the canonical case)
# - resume          → only learnings delta; using-agent-harness already in context
# - precompact      → inject nothing (compact is meant to free space; re-injecting
#                     the same content defeats the purpose)
if [ "$SESSION_SOURCE" = "precompact" ]; then
    # Issue #81 — precompact checkpoint: snapshot recovery hints before
    # compact discards context. The checkpoint is a small pointer file
    # (not the content itself) so the next startup can offer to resume
    # in-progress work. Best-effort: never fail the hook on checkpoint errors.
    checkpoint_dir="${CLAUDE_PROJECT_DIR:-$(git rev-parse --show-toplevel 2>/dev/null)}"
    if [ -n "$checkpoint_dir" ] && [ -d "$checkpoint_dir" ]; then
        checkpoint_file="$checkpoint_dir/.agent-harness/last-session-checkpoint.md"
        mkdir -p "$checkpoint_dir/.agent-harness" 2>/dev/null || true
        {
            echo "# Last Session Checkpoint"
            echo ""
            echo "Generated: $(date -u +%Y-%m-%dT%H:%M:%SZ)"
            echo "Session: ${SESSION_ID:-unknown}"
            echo "Trigger: precompact"
            echo ""
            echo "## Recovery Hints"
            echo ""
            echo "Compact just fired. The following may have been dropped from context:"
            echo ""
            echo "- Sprint contract (if any): docs/agent-harness/contracts/*.contract.md"
            echo "- Active plans (max 2 recommended, see writing-plans): docs/agent-harness/plans/*.md"
            echo "- Recent learnings: .agent-harness/learnings.jsonl (auto-injected next startup)"
            echo ""
            echo "## Recommended Next Steps"
            echo ""
            echo "1. If 2+ plans are still active, finish or shelve one before starting new work."
            echo "2. If clarification loops happened (see loop-detection), ask for the desired"
            echo "   outcome instead of listing more options."
            echo "3. If context pressure continues, start a fresh session."
        } > "$checkpoint_file" 2>/dev/null || true
    fi

    # Emit an empty-but-valid JSON for each platform.
    if [ -n "${CURSOR_PLUGIN_ROOT:-}" ]; then
        printf '{\n  "additional_context": ""\n}\n' | cat
    elif [ -n "${CLAUDE_PLUGIN_ROOT:-}" ] && [ -z "${COPILOT_CLI:-}" ]; then
        printf '{\n  "hookSpecificOutput": {\n    "hookEventName": "SessionStart",\n    "additionalContext": ""\n  }\n}\n' | cat
    else
        printf '{\n  "additionalContext": ""\n}\n' | cat
    fi
    exit 0
fi

# Read using-agent-harness content (full on startup/clear, empty on resume)
using_agent_harness_content=""
if [ "$SESSION_SOURCE" = "startup" ] || [ "$SESSION_SOURCE" = "clear" ]; then
    using_agent_harness_content=$(cat "${PLUGIN_ROOT}/skills/using-agent-harness/SKILL.md" 2>&1 || echo "Error reading using-agent-harness skill")
fi

# Read project learnings if they exist (injected on every source except precompact).
# On resume we still inject learnings (they may have grown since the session paused).
learnings_content=""
# Resolve project root the same way log/search-learnings.sh do (v2):
# prefer CLAUDE_PROJECT_DIR, fall back to git rev-parse for manual/CI runs.
LEARNINGS_DIR="${CLAUDE_PROJECT_DIR:-$(git rev-parse --show-toplevel 2>/dev/null)}"
if [ -f "$LEARNINGS_DIR/.agent-harness/learnings.jsonl" ]; then
    learnings_count=$(wc -l < "$LEARNINGS_DIR/.agent-harness/learnings.jsonl" | tr -d ' ')
    if [ "$learnings_count" -gt 0 ]; then
        # Get formatted summary using search script.
        # Throttle: when learnings exceed 50 entries, only inject top-5 high-confidence
        # entries from the last 30 days. Saves ~10KB per session (see issue #64).
        if [ -x "${PLUGIN_ROOT}/scripts/search-learnings.sh" ]; then
            if [ "$learnings_count" -ge 50 ]; then
                formatted_learnings=$("${PLUGIN_ROOT}/scripts/search-learnings.sh" --summary \
                    --max-entries 5 --min-confidence 7 --recent-within-days 30 2>/dev/null || true)
            else
                formatted_learnings=$("${PLUGIN_ROOT}/scripts/search-learnings.sh" --summary 2>/dev/null || true)
            fi
        else
            # Fallback to raw JSON
            formatted_learnings=$(tail -10 "$LEARNINGS_DIR/.agent-harness/learnings.jsonl" 2>/dev/null || true)
        fi
        if [ -n "$formatted_learnings" ]; then
            learnings_content="\n\n## Project Learnings\n\n${formatted_learnings}\n\nReview these before making changes. Use 'session-learnings' skill to add new learnings."
        fi
    fi
fi

# Headless skill invocation tip — only on startup/clear, not resume.
headless_tip=""
if [ "$SESSION_SOURCE" = "startup" ] || [ "$SESSION_SOURCE" = "clear" ]; then
    headless_tip="\n\n## Skill Invocation Best Practice\nWhen programmatically invoking skills (tests, CI, -p mode), use imperative form:\n  ✅ 'Invoke the Skill tool with brainstorming'\n  ❌ '/brainstorming'\n"
fi

# Knowledge base pointer (one line) — only on startup/clear for agent-harness KB projects.
# Just point at the KB index, never inject the body. Two-level lookup, no **/*.md glob.
kb_hint=""
if { [ "$SESSION_SOURCE" = "startup" ] || [ "$SESSION_SOURCE" = "clear" ]; } \
   && [ -f "$LEARNINGS_DIR/docs/agent-harness/index.md" ]; then
    kb_hint="\n\n## Knowledge Base\nAgent Harness 知识库入口: docs/agent-harness/index.md（仅用于本项目知识库检索：两级查找，不要对 docs/agent-harness 使用 **/*.md 全局通配）\n"
fi

# Inject CONTEXT.md glossary summary (cache-friendly, issue #79).
# Placed in static segment (with using-agent-harness, headless_tip, kb_hint)
# so prompt cache prefix stays stable. CONTEXT.md is structural vocabulary,
# not per-session churn like learnings.
context_md_hint=""
if { [ "$SESSION_SOURCE" = "startup" ] || [ "$SESSION_SOURCE" = "clear" ]; }; then
    if [ -f "$LEARNINGS_DIR/CONTEXT.md" ]; then
        # Extract ## headings + first line of definition, cap at 20 terms
        context_terms=$(grep -A 1 "^## " "$LEARNINGS_DIR/CONTEXT.md" 2>/dev/null | head -60 || true)
        term_count=$(grep -c "^## " "$LEARNINGS_DIR/CONTEXT.md" 2>/dev/null) || term_count=0
        if [ -n "$context_terms" ]; then
            if [ "$term_count" -gt 20 ]; then
                context_md_hint="\n\n## Domain Glossary\n${context_terms}\n\n(${term_count} terms total — see CONTEXT.md for full glossary)\n"
            else
                context_md_hint="\n\n## Domain Glossary\n${context_terms}\n"
            fi
        fi
    elif [ ! -f "$LEARNINGS_DIR/.agent-harness/.context-md-dismissed" ]; then
        # One-time discovery hint: project has no CONTEXT.md and user hasn't dismissed.
        # Shows once per session (startup/clear only) until user either:
        # - creates CONTEXT.md (via /domain-modeling or /harness-init) → hint naturally disappears
        # - touches .agent-harness/.context-md-dismissed → explicit dismiss
        context_md_hint="\n\n## Domain Glossary\nNo CONTEXT.md found. If this project has domain-specific terminology, run /domain-modeling to create one, or re-run /harness-init. To dismiss this hint: touch .agent-harness/.context-md-dismissed\n"
    fi
fi

# Issue #81 — checkpoint recovery hint. On startup/clear, if the previous
# session wrote a precompact checkpoint, surface a one-line pointer so the
# agent can offer to resume in-progress work. The checkpoint file is removed
# after being surfaced (one-shot, not every startup).
checkpoint_hint=""
if [ "$SESSION_SOURCE" = "startup" ] || [ "$SESSION_SOURCE" = "clear" ]; then
    ckpt_dir="${CLAUDE_PROJECT_DIR:-$(git rev-parse --show-toplevel 2>/dev/null)}"
    ckpt_file="$ckpt_dir/.agent-harness/last-session-checkpoint.md"
    if [ -n "$ckpt_dir" ] && [ -f "$ckpt_file" ]; then
        checkpoint_hint="\n\n## Prior Session Checkpoint (issue #81)\nThe previous session ended with a /compact. Recovery hints at: .agent-harness/last-session-checkpoint.md — read it if you need to resume in-progress plans or sprint contracts, then delete it once consumed.\n"
        # One-shot: remove after surfacing so subsequent startups don't re-prompt.
        rm -f "$ckpt_file" 2>/dev/null || true
    fi
fi

# Escape string for JSON embedding using bash parameter substitution.
escape_for_json() {
    local s="$1"
    s="${s//\\/\\\\}"
    s="${s//\"/\\\"}"
    s="${s//$'\n'/\\n}"
    s="${s//$'\r'/\\r}"
    s="${s//$'\t'/\\t}"
    printf '%s' "$s"
}

using_agent_harness_escaped=$(escape_for_json "$using_agent_harness_content")
warning_escaped=$(escape_for_json "$warning_message")
learnings_escaped=$(escape_for_json "$learnings_content")
headless_tip_escaped=$(escape_for_json "$headless_tip")
kb_hint_escaped=$(escape_for_json "$kb_hint")
context_md_hint_escaped=$(escape_for_json "$context_md_hint")
checkpoint_hint_escaped=$(escape_for_json "$checkpoint_hint")

# Build the session context.
# - startup / clear: full wrapper with using-agent-harness body + learnings + tip
# - resume: lean payload — using-agent-harness is already in the prior context,
#   so we inject only the learnings refresh (and warning if present). No empty
#   "Below is the full content..." heading.
#
# Cache-friendly ordering (issue #79): Anthropic prompt caching is prefix-match.
# Static segments (using-agent-harness, headless_tip, kb_hint) are placed first
# so they form a stable prefix; dynamic segments (warning, learnings) go last
# so their per-session churn does not invalidate the cache hit on the prefix.
if [ "$SESSION_SOURCE" = "resume" ]; then
    session_context="${warning_escaped}${learnings_escaped}${checkpoint_hint_escaped}"
else
    session_context="<EXTREMELY_IMPORTANT>\nYou have agent-harness.\n\n**Below is the full content of your 'agent-harness:using-agent-harness' skill - your introduction to using skills. For all other skills, use the 'Skill' tool:**\n\n${using_agent_harness_escaped}${headless_tip_escaped}${kb_hint_escaped}${context_md_hint_escaped}\n\n${warning_escaped}${learnings_escaped}${checkpoint_hint_escaped}\n</EXTREMELY_IMPORTANT>"
fi

# Output context injection as JSON.
if [ -n "${CURSOR_PLUGIN_ROOT:-}" ]; then
  printf '{\n  "additional_context": "%s"\n}\n' "$session_context" | cat
elif [ -n "${CLAUDE_PLUGIN_ROOT:-}" ] && [ -z "${COPILOT_CLI:-}" ]; then
  printf '{\n  "hookSpecificOutput": {\n    "hookEventName": "SessionStart",\n    "additionalContext": "%s"\n  }\n}\n' "$session_context" | cat
else
  printf '{\n  "additionalContext": "%s"\n}\n' "$session_context" | cat
fi

exit 0
